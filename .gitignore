# -------------------------------------------------------
# Back2Kasi — .gitignore
# -------------------------------------------------------

# ── Local secrets (NEVER commit) ──────────────────────
**/application-local.properties
**/application-local.yml
**/.env
**/.env.local
**/key.properties
**/*.jks
**/*.keystore

# ── Cloudflare Worker & Node ──────────────────────────
**/node_modules/
**/.wrangler/
dist/
*.bundle.mjs


# ── Maven build output ────────────────────────────────
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE ───────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Binary Packages & Builds ──────────────────────────
*.apk
Back2Kasi.apk
*.idsig

# ── Logs ──────────────────────────────────────────────
*.log
logs/

# ── Spring Boot ───────────────────────────────────────
spring-shell.log
