# -------------------------------------------------------
# Back2Kasi — .gitignore
# -------------------------------------------------------

# ── Local secrets (NEVER commit) ──────────────────────
**/application-local.properties
**/application-local.yml
**/.env
**/.env.local

# ── Maven build output ────────────────────────────────
**/target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ── IDE ───────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs ──────────────────────────────────────────────
*.log
logs/

# ── Spring Boot ───────────────────────────────────────
spring-shell.log
