{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "back2kasi-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "back2kasi-db",
      "database_id": "02505f46-9302-4e76-af39-ab313316f21e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "JWT_EXPIRATION_SECONDS": "86400",
    "DEFAULT_JWT_SECRET": "back2kasi-jwt-secret-free-tier-2026-key"
  }
}
